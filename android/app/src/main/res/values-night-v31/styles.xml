<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash while the process is starting in dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowLightSplashScreen">false</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
